<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>disabled</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RepositoryType>git</RepositoryType>
    <PackageTags>virus; malo; horroroso; terrorifico; ransomware; spyware; adware; bloatware; jumpsware;</PackageTags>
    <AssemblyVersion>1.1.1</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <Version>$(VersionPrefix)</Version>
    <ApplicationIcon>package.ico</ApplicationIcon>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <IsPublishable>True</IsPublishable>
    <StartupObject>DSFiles_Client.Program</StartupObject>
  </PropertyGroup>

	<PropertyGroup>
		<OptimizeImplicitlyTriggeredBuild>True</OptimizeImplicitlyTriggeredBuild>
	</PropertyGroup>

	<ItemGroup>
    <Content Include="package.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="6.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Terminal.Gui" Version="2.6.0-develop.61" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DSFiles_Shared\DSFiles_Shared.csproj" />
  </ItemGroup>
</Project>
