FROM mcr.microsoft.com/dotnet/sdk:11.0.100-rc.3-resolute AS build
WORKDIR /src

RUN apt-get update \
 && apt-get install -y --no-install-recommends clang zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

COPY global.json ./
COPY DSFiles_Shared/DSFiles_Shared.csproj DSFiles_Shared/
COPY DSFiles-Server/DSFiles_Server.csproj DSFiles-Server/
RUN dotnet restore DSFiles-Server/DSFiles_Server.csproj -r linux-x64 -p:NativeAot=true

COPY DSFiles_Shared/ DSFiles_Shared/
COPY DSFiles-Server/ DSFiles-Server/
RUN dotnet publish DSFiles-Server/DSFiles_Server.csproj -c Release -r linux-x64 -o /app --no-restore \
    -p:NativeAot=true -p:DebugType=None -p:DebugSymbols=false

FROM mcr.microsoft.com/dotnet/runtime-deps:11.0.0-rc.3-resolute AS runtime
WORKDIR /DSFiles-Server

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && curl -fsSL https://packages.microsoft.com/config/ubuntu/26.04/packages-microsoft-prod.deb -o /tmp/packages-microsoft-prod.deb \
 && dpkg -i /tmp/packages-microsoft-prod.deb \
 && rm /tmp/packages-microsoft-prod.deb \
 && apt-get update \
 && apt-get install -y --no-install-recommends libmsquic \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/ ./

ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_EnableDiagnostics=0
EXPOSE 8080
EXPOSE 20022/udp
ENTRYPOINT ["./DSFiles_Server"]
